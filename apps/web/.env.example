# Web App Environment Variables
# Copy to .env.local for local development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (also powers public endpoint rate limiting — fails open if unset)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# Optional rate limit overrides (requests per window; window default 60s)
# RATE_LIMIT_QUOTES_IP=5
# RATE_LIMIT_QUOTES_TENANT=30
# RATE_LIMIT_UPLOADS_IP=20
# RATE_LIMIT_UPLOADS_TENANT=100
# RATE_LIMIT_CHAT_IP=15
# RATE_LIMIT_CHAT_TENANT=100
# RATE_LIMIT_WINDOW_SECONDS=60

# Cloudflare Turnstile bot protection (quote submission).
# Leave BOTH unset to disable (fails open). IMPORTANT: setting the secret
# makes tokens mandatory — only enable once the embed clients sending tokens
# are deployed. Test keys: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=estimator-assets
# Optional: Override endpoint (defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# DocRaptor PDF
DOCRAPTOR_API_KEY=your-docraptor-api-key
# Set to 'true' to use test mode (free, watermarked PDFs)
DOCRAPTOR_TEST_MODE=true

# Postmark Email
POSTMARK_API_TOKEN=your-postmark-token
POSTMARK_FROM_EMAIL=quotes@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# T-102: Billing Meter event name for per-quote overage (must match a Meter in Stripe)
STRIPE_OVERAGE_METER_EVENT=estimate_overage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare Worker (Queue)
CLOUDFLARE_WORKER_URL=http://localhost:8787
# Same value as the worker's CLOUDFLARE_WORKER_TOKEN secret — the worker rejects job requests without it
CLOUDFLARE_WORKER_TOKEN=your-worker-auth-token
# true = request waits for the worker (/process); false = enqueue (/trigger, Cloudflare Queue).
# Unset: sync in local dev, async in production.
SYNC_QUOTE_PROCESSING=

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ENCRYPTION_KEY=your-32-char-encryption-key

# Quote lifecycle cron (/api/cron/lifecycle — expiry + reminders).
# Vercel sends "Authorization: Bearer $CRON_SECRET" automatically; the route
# refuses to run without it. Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret
# Days after sending before the single follow-up reminder email (default 3)
# REMINDER_AFTER_DAYS=3

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS channel — Twilio (T-136). Platform account; each tenant connects a number at /app/sms.
# Without both credentials (or with SMS_TEST_MODE=true) outbound texts are recorded, never sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL Twilio calls (only if it differs from NEXT_PUBLIC_APP_URL, e.g. behind a tunnel)
TWILIO_WEBHOOK_BASE_URL=
SMS_TEST_MODE=

# Plans (T-134): Stripe price ids per plan/interval/currency — generate with
#   cd apps/web && STRIPE_SECRET_KEY=sk_test_... npx tsx scripts/stripe-setup-plans.mts
STRIPE_PRICE_US_STARTER_MONTHLY_USD=
STRIPE_PRICE_US_STARTER_ANNUAL_USD=
STRIPE_PRICE_US_PRO_MONTHLY_USD=
STRIPE_PRICE_US_PRO_ANNUAL_USD=
STRIPE_PRICE_US_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_US_BUSINESS_ANNUAL_USD=

# T-144: Meta Pixel + Conversions API (marketing pages only; off when unset)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: META_GRAPH_API_VERSION=v21.0, META_TEST_EVENT_CODE=TEST12345 (Events Manager → Test events)

# T-153: the public demo on /demo (counted in the database, so they hold without Upstash).
# Over either limit the page shows a recorded example estimate. 0 turns live demo runs off.
DEMO_DAILY_CAP=200
# DEMO_IP_LIMIT_PER_HOUR=5
