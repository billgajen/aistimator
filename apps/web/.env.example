# Web App Environment Variables
# Copy to .env.local for local development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis: the public rate limits (T-173). Every limit is in
# src/lib/rate-limit-config.ts; no limit is set here. Leave both unset and
# rate limiting is OFF (requests go through, and the log says so once).
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token
# T-178: the one switch that turns every public rate limit off without removing the two values above.
# RATE_LIMITS_OFF=true

# Cloudflare Turnstile: the human check on request submission and sign-up (T-173).
# Set BOTH or neither. With either one unset the check is OFF (the log says so
# once). With both set, a request whose token Cloudflare clearly rejects is
# refused; anything else (no token, Cloudflare slow or down) goes ahead (T-178).
# Cloudflare's published test keys (always pass): site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# T-178: the one switch that turns the human check off on the server without removing the keys.
# It only ever blocks a token Cloudflare clearly rejects; no token, a slow or unreachable Cloudflare all go ahead.
# TURNSTILE_OFF=true

# For tests only, ignored in production: stand-ins for Cloudflare's token check
# and for Postmark (scripts/hardcore-test/verify-t173.mts runs both)
# TURNSTILE_VERIFY_URL=http://127.0.0.1:8793/turnstile/siteverify
# POSTMARK_API_BASE_URL=http://127.0.0.1:8793/postmark

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=estimator-assets
# Optional: Override endpoint (defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# DocRaptor PDF
DOCRAPTOR_API_KEY=your-docraptor-api-key
# Set to 'true' to use test mode (free, watermarked PDFs)
DOCRAPTOR_TEST_MODE=true

# Postmark Email
POSTMARK_API_TOKEN=your-postmark-token
# Production: quotes@qolumns.com (T-174). The sender name is added in code (shared/email-from.ts).
POSTMARK_FROM_EMAIL=quotes@yourdomain.com

# Stripe (T-180). The account uses Managed Payments: Stripe is the merchant of record.
# Locally: the sandbox's secret key. In Vercel Production: the live key.
STRIPE_SECRET_KEY=sk_test_...
# The signing secret of the one webhook endpoint (https://<site>/api/webhooks/stripe). In production:
# Stripe dashboard, Developers, Webhooks, the endpoint, "Signing secret". Locally any value works:
# scripts/hardcore-test/verify-t180.mts signs the events it delivers with whatever is set here.
STRIPE_WEBHOOK_SECRET=whsec_...
# T-102: Billing Meter event name for per-quote overage (must match a Meter in Stripe)
STRIPE_OVERAGE_METER_EVENT=estimate_overage
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Cloudflare Worker (Queue)
CLOUDFLARE_WORKER_URL=http://localhost:8787
# Same value as the worker's CLOUDFLARE_WORKER_TOKEN secret — the worker rejects job requests without it
CLOUDFLARE_WORKER_TOKEN=your-worker-auth-token
# true = request waits for the worker (/process); false = enqueue (/trigger, Cloudflare Queue).
# Unset: sync in local dev, async in production.
SYNC_QUOTE_PROCESSING=

# WhatsApp Business API
# T-175: one-click connect (Meta Embedded Signup). Set all five in Vercel; the worker needs none.
# Public ids of the platform's Meta app and of its Embedded Signup configuration (not secrets):
NEXT_PUBLIC_WHATSAPP_APP_ID=your-meta-app-id
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=your-embedded-signup-configuration-id
# The Meta app's secret: exchanges the sign-up code and checks every webhook call's signature. Secret.
WHATSAPP_APP_SECRET=your-meta-app-secret
# The string typed into Meta's webhook settings as "Verify token". Any long random string.
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# Encrypts each business's stored token. Secret. Generate: openssl rand -hex 32. Without it nothing
# connects (there is no built-in fallback). Changing it later makes every stored connection unreadable.
WHATSAPP_ENCRYPTION_KEY=your-long-random-encryption-key
# Local checks only (ignored in production): send Graph API calls to a stand-in for Meta.
# WHATSAPP_GRAPH_BASE_URL=http://127.0.0.1:8799
# T-177, checks only (ignored in production): a local stand-in that answers "is this a price request?" in place of the AI model
# WHATSAPP_INTENT_BASE_URL=http://127.0.0.1:8799/ai
# T-178, checks only (ignored in production): a local stand-in that answers the request form's "does this description fit the chosen service?" in place of the AI model
# SERVICE_MATCH_BASE_URL=http://127.0.0.1:8797/ai

# Quote lifecycle cron (/api/cron/lifecycle — expiry + reminders).
# Vercel sends "Authorization: Bearer $CRON_SECRET" automatically; the route
# refuses to run without it. Generate: openssl rand -hex 32
CRON_SECRET=your-cron-secret
# Days after sending before the single follow-up reminder email (default 3)
# REMINDER_AFTER_DAYS=3

# App: the address every link, QR code and embed snippet is built from.
# Production: https://qolumns.com (T-174). The other names are in packages/shared/src/domains.json.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# T-177: the company number shown on the Privacy and Terms pages (public, not a secret). Left empty, the sentence omits it.
NEXT_PUBLIC_COMPANY_NUMBER=

# SMS channel — Twilio (T-136). Platform account; each tenant connects a number at /app/sms.
# Without both credentials (or with SMS_TEST_MODE=true) outbound texts are recorded, never sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public base URL Twilio calls (only if it differs from NEXT_PUBLIC_APP_URL, e.g. behind a tunnel)
TWILIO_WEBHOOK_BASE_URL=
SMS_TEST_MODE=

# Plans (T-134, T-180): Stripe price ids per plan/interval/currency. They differ between the sandbox and
# the live account. The setup script creates the prices and prints these lines:
#   sandbox:  cd apps/web && npx tsx scripts/stripe-setup-plans.mts --write-env
#   live:     cd apps/web && npx tsx scripts/stripe-setup-plans.mts --live     (then paste into Vercel)
STRIPE_PRICE_US_STARTER_MONTHLY_USD=
STRIPE_PRICE_US_STARTER_ANNUAL_USD=
STRIPE_PRICE_US_PRO_MONTHLY_USD=
STRIPE_PRICE_US_PRO_ANNUAL_USD=
STRIPE_PRICE_US_BUSINESS_MONTHLY_USD=
STRIPE_PRICE_US_BUSINESS_ANNUAL_USD=

# T-144: Meta Pixel + Conversions API (marketing pages only; off when unset)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: META_GRAPH_API_VERSION=v21.0, META_TEST_EVENT_CODE=TEST12345 (Events Manager → Test events)

# T-153: the public demo on /demo (counted in the database, so they hold without Upstash).
# Over either limit the page shows a recorded example estimate. 0 turns live demo runs off.
DEMO_DAILY_CAP=200
# DEMO_IP_LIMIT_PER_HOUR=5
