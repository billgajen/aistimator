# The web app (the API lives there). No slash at the end.
#   your phone against production:  https://qolumns.com
#   the local stack:                http://<this Mac's network address>:3000   (a phone cannot reach "localhost")
EXPO_PUBLIC_API_URL=http://localhost:3000

# The Supabase project the web app uses. Both values are public by design
# (the anon key is in every browser; row-level security protects the data).
#   production: the same two values the web app has in Vercel as
#               NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY
#               (also in the Supabase dashboard: Project Settings, API)
#   local:      http://<this Mac's network address>:54321 and the local anon key
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
