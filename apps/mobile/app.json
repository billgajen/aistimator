{
  "expo": {
    "name": "Qolumns",
    "slug": "qolumns",
    "scheme": "qolumns",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.qolumns.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of the job so it can be priced, and scan a room to measure it.",
        "NSPhotoLibraryUsageDescription": "Choose photos of the job so it can be priced."
      }
    },
    "android": {
      "package": "com.qolumns.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#192822"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take photos of the job so it can be priced, and scan a room to measure it.",
          "photosPermission": "Choose photos of the job so it can be priced.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#FAF9F6"
  }
}
