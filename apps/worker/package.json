{
  "name": "@qolumns/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist && wrangler deploy --dry-run -c wrangler.addresses.toml --outdir=dist/addresses",
    "deploy": "wrangler deploy",
    "dev:addresses": "wrangler dev -c wrangler.addresses.toml --port 8799",
    "deploy:addresses": "wrangler deploy -c wrangler.addresses.toml --env production",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@qolumns/shared": "workspace:*",
    "@supabase/supabase-js": "^2.44.0",
    "@upstash/redis": "^1.36.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18",
    "wrangler": "^4.165.0"
  }
}
